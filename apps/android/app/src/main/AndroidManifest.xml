<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@android:style/Theme.DeviceDefault.Light"
        android:usesCleartextTraffic="true">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|keyboardHidden">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- A tap on an NFC tag with a web address (https://your-server/nfc?t=...) opens the app. The app only
                 loads the address if it belongs to the server it is connected to (or the user confirms it once).
                 The wildcard host is what makes Android apply the path filter: without a host it would be ignored
                 and the app would be offered for every web link. -->
            <intent-filter>
                <action android:name="android.nfc.action.NDEF_DISCOVERED" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="https" android:host="*" android:pathPrefix="/nfc" />
                <data android:scheme="http" android:host="*" android:pathPrefix="/nfc" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="*" android:pathPrefix="/nfc" />
                <data android:scheme="http" android:host="*" android:pathPrefix="/nfc" />
            </intent-filter>
        </activity>
    </application>
</manifest>
