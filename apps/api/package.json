{
  "name": "@dienst/api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/server.ts",
    "start": "tsx --env-file-if-exists=../../.env src/server.ts",
    "db:migrate": "tsx --env-file-if-exists=../../.env src/db/migrate-cli.ts",
    "db:seed": "tsx --env-file-if-exists=../../.env src/db/seed.ts",
    "db:codegen": "kysely-codegen --dialect postgres --date-parser string --numeric-parser number --out-file src/db/types.ts --env-file ../../.env",
    "typecheck": "tsc -p .",
    "test": "vitest run",
    "security:rekey": "tsx --env-file-if-exists=../../.env src/db/rekey.ts",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@dienst/rules": "workspace:*",
    "@dienst/shared": "workspace:*",
    "@fastify/cookie": "^11.0.0",
    "@fastify/cors": "^11.0.0",
    "@fastify/helmet": "^13.0.0",
    "@fastify/multipart": "^9.0.0",
    "@fastify/rate-limit": "^10.0.0",
    "@fastify/swagger": "^9.9.1",
    "@simplewebauthn/server": "^14.0.3",
    "argon2": "^0.44.0",
    "date-fns": "^4.1.0",
    "date-fns-tz": "^3.2.0",
    "exceljs": "^4.4.0",
    "fastify": "^5.5.0",
    "fastify-type-provider-zod": "^6.0.0",
    "jose": "^6.0.0",
    "kysely": "^0.28.0",
    "nodemailer": "^10.0.14",
    "otplib": "^12.0.1",
    "pdfkit": "^0.17.0",
    "pg": "^8.16.0",
    "pino": "^9.0.0",
    "prom-client": "^15.1.3",
    "qrcode": "^1.5.4",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@types/nodemailer": "^7.0.0",
    "@types/pdfkit": "^0.17.0",
    "@types/pg": "^8.15.0",
    "@types/qrcode": "^1.5.5",
    "kysely-codegen": "^0.19.0",
    "tsx": "^4.20.0",
    "vitest": "^4.1.11"
  }
}
