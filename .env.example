# Copy to .env (git-ignored)
DATABASE_URL=postgres://dienst:dienst@localhost:5432/dienst
TEST_DATABASE_URL=postgres://dienst:dienst@localhost:5432/dienst_test
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
TOTP_ENC_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
SMTP_HOST=localhost
SMTP_PORT=1025
MAIL_FROM=Dienstplan <noreply@dienst.local>
WEB_ORIGIN=http://localhost:5173
API_PORT=3000
COOKIE_SECURE=false
# Rate limits per minute and client (login/refresh, tablet, every other route)
RATE_LIMIT_AUTH=10
RATE_LIMIT_KIOSK=60
RATE_LIMIT_GLOBAL=600
# true behind a reverse proxy (client IP from X-Forwarded-For)
TRUST_PROXY=false
# production refuses the development secrets and requires COOKIE_SECURE=true
NODE_ENV=development
MAIL_MODE=smtp
