# Copy to .env (git-ignored)
DATABASE_URL=postgres://dienst:dienst@localhost:5432/dienst
TEST_DATABASE_URL=postgres://dienst:dienst@localhost:5432/dienst_test
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
# Signing secret (any random string, 32+ chars). Session, tablet and SSO tokens use keys derived from it.
# DATA_KEY: 64 hex characters for data at rest (documents, TOTP secrets, SSO secrets, badge hashes).
#   generate:  openssl rand -hex 32
# Both must be different values. For rotation put the old value into the *_PREVIOUS variable (comma
# separated) and run `pnpm security:rekey` afterwards.
# TOTP_ENC_KEY is only the legacy key of databases written before DATA_KEY existed; leave it unset on new installs.
DATA_KEY=f0e1d2c3b4a5968778695a4b3c2d1e0ff0e1d2c3b4a5968778695a4b3c2d1e0f
#JWT_SECRET_PREVIOUS=
#DATA_KEY_PREVIOUS=
#TOTP_ENC_KEY=
SMTP_HOST=localhost
SMTP_PORT=1025
MAIL_FROM=Dienstplan <noreply@dienst.local>
WEB_ORIGIN=http://localhost:5173
API_PORT=3000
COOKIE_SECURE=false
# Rate limits per minute and client (login/refresh, tablet, every other route)
RATE_LIMIT_AUTH=10
RATE_LIMIT_KIOSK=60
RATE_LIMIT_GLOBAL=600
# Whose X-Forwarded-For to believe: false, the number of reverse proxies in front (e.g. 1), or their
# addresses/CIDRs (10.0.0.0/8,192.168.1.5). `true` believes every hop and is refused in production.
TRUST_PROXY=false
# SSO: may the server call private/loopback addresses? default false in production, true otherwise
#OUTBOUND_ALLOW_PRIVATE=false
# production refuses the development secrets and requires COOKIE_SECURE=true
NODE_ENV=development
MAIL_MODE=smtp
